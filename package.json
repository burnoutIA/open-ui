{
  "name": "open-ui",
  "version": "2.0.0",
  "description": "Open UI — agent-first design system workspace",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.js",
    "graph": "node scripts/graph.js",
    "graph:check": "node scripts/graph.js --check",
    "list": "node scripts/list-components.js",
    "validate": "node scripts/validate-json.js",
    "lint:scss": "stylelint \"dev/assets/scss/**/*.scss\" --allow-empty-input",
    "test:a11y": "node scripts/test-a11y.js",
    "test": "vitest run --passWithNoTests",
    "test:empty": "node scripts/test-empty-workspace.js",
    "test:watch": "vitest",
    "impact": "node scripts/impact.js",
    "skills:import": "node scripts/skill-harness.js import --from codex",
    "skills:build": "node scripts/skill-harness.js build",
    "skills:check": "node scripts/skill-harness.js check",
    "skills:list-targets": "node scripts/skill-harness.js list",
    "clean": "node scripts/clean-build.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.10.0",
    "postcss": "^8.4.0",
    "prismjs": "^1.30.0",
    "sass": "^1.80.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "tailwindcss": "^4.0.0",
    "twig": "^3.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
